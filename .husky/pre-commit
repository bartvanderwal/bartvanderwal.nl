#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running Jekyll build and link validation..."
./serve check

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Build validation failed! Fix the errors above before committing."
    echo ""
    echo "Common issues:"
    echo "  - Missing alt attributes on images"
    echo "  - Broken internal links"
    echo "  - Title length > 36 characters"
    echo "  - Wrong caption format"
    echo ""
    exit 1
fi

echo ""
echo "✅ Build validation passed!"
