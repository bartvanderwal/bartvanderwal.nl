---
layout: null
---
[
  {% for post in site.posts %}
    {
      "title"       : "{{ post.title | escape }}",
      "category"    : "{{ post.category }}",
      "tags"        : "{{ post.tags | join: ', ' }}",
      "url"         : ".{{ post.url }}",
      "date"        : "{{ post.date }}",
      "description" : {{ post.description | default: post.content | strip_html | truncatewords: 50 | json_escape }},
      "content"     : {{ post.content | strip_html | json_escape }}
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
