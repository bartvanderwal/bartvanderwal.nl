---
layout: null
---
[
  {% for post in site.posts %}
    {
      "title"       : "{{ post.title | escape }}",
      "category"    : "{{ post.category }}",
      "tags"        : "{{ post.tags | join: ', ' }}",
      "url"         : ".{{ post.url }}",
      "date"        : "{{ post.date }}",
      "description" : "{% if post.description and post.description != '' %}{{ post.description | escape }}{% else %}{{ post.content | strip_html | truncate: 50 | escape }}{% endif %}",
      "content"     : {{ post.content | strip_html | strip_newlines | normalize_whitespace | jsonify }}
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
